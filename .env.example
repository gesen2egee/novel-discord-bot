# Discord 機器人 Token (必填，至 Discord Developer Portal 取得)
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Jina Reader API Key (選填，免 Key 亦可免費使用)
JINA_API_KEY=

# Google 試算表 Webhook 網址 (選填，自動同步新增推書至 Google Sheet)
GOOGLE_SHEET_WEBHOOK_URL=

# Google 試算表共用瀏覽連結 (選填，若有設定則卡片下方會出現「📊 查看線上書單」跳轉按鈕)
GOOGLE_SHEET_VIEW_URL=
