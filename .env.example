# Discord 機器人 Token (必填，至 Discord Developer Portal 取得)
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# 頻道限制設定 (選填，可填頻道名稱關鍵字或頻道 ID，例如: 懶人推書 或 懶人推書,小說推薦，留空則允許所有文字頻道)
ALLOWED_CHANNELS=懶人推書

# Jina Reader API Key (選填，免 Key 亦可免費使用)
JINA_API_KEY=

# Google 試算表 Webhook 網址 (選填，自動同步新增推書至 Google Sheet)
GOOGLE_SHEET_WEBHOOK_URL=

# Google 試算表共用瀏覽連結 (預設已內建您的試算表)
GOOGLE_SHEET_VIEW_URL=https://docs.google.com/spreadsheets/d/13COcdiJUUFApMDVBbBTf0wY2utr9gGjW12gio43Awqc/edit?gid=0#gid=0
