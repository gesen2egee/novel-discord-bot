# Discord 機器人 Token (必填，至 Discord Developer Portal 取得)
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Jina Reader API Key (選填，免 Key 亦可免費使用)
JINA_API_KEY=

# 推書彙整頻道設定 (選填，若不填則機器人會自動尋找包含「推書」或「推書彙整」名稱的文字頻道)
RECOMMEND_CHANNEL_ID=
RECOMMEND_CHANNEL_NAME=推書彙整

# Google 試算表 Webhook 網址 (選填，若有設定則自動同步新增推書至 Google Sheet)
GOOGLE_SHEET_WEBHOOK_URL=
